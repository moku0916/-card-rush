*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",sans-serif;
}

body{

    background:#111;
    color:white;
    min-height:100vh;

}

#app{

    width:100%;
    max-width:900px;
    margin:auto;
    padding:25px;

}

header{

    text-align:center;
    margin-bottom:30px;

}

h1{

    color:#FFD700;
    font-size:42px;

}

.subTitle{

    color:#bbb;
    margin-top:8px;

}

.screen{

    display:flex;
    flex-direction:column;
    gap:18px;

}

.hidden{

    display:none;

}

button{

    padding:18px;
    font-size:22px;
    border:none;
    border-radius:14px;
    background:#222;
    color:white;
    cursor:pointer;
    transition:.2s;

}

button:hover{

    background:#FFD700;
    color:black;

}

#horseArea{

    background:#1d1d1d;
    border-radius:12px;
    padding:15px;
    min-height:180px;

}

#logArea{

    background:#222;
    border-radius:12px;
    padding:15px;
    min-height:140px;
    white-space:pre-wrap;

}

.backButton{

    background:#444;

}

select{

    font-size:18px;
    padding:8px;
    margin-top:8px;
    width:180px;

}

h2{

    color:#FFD700;

	}